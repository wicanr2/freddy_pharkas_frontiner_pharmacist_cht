+				const int d = dr * dr + dg * dg + db * db;
+				if (d < best) { best = d; bi = i; }
+			}
+			_chtTitleMap[c] = (byte)bi;
+		}
+		_chtTitleMapped = true;
+	}
+
+	const int sw = _screen->getWidth();
+	const int sh = _screen->getHeight();
+	uint32 i = 0;
+	for (uint16 yy = 0; yy < _chtTitleH; yy++) {
+		for (uint16 xx = 0; xx < _chtTitleW; xx++, i++) {
+			const byte idx = _chtTitleData[i];
+			if (idx == 0xFF || idx >= _chtTitleMap.size())
+				continue;
+			const int px = _chtTitleX + xx, py = _chtTitleY + yy;
+			if (px >= 0 && py >= 0 && px < sw && py < sh)
+				_screen->putPixel(px, py, GFX_SCREEN_MASK_VISUAL, _chtTitleMap[idx], 0, 0);
+		}
