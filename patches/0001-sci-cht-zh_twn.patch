+// CHT: collapse every run of whitespace (space, \r, \n, \t) to a single space and trim
+// the ends. SCI message resources embed hard "\r\n" line breaks, but translation.tsv keys
+// are single-line with those breaks flattened to spaces -- without this the runtime string
+// (e.g. the kFormat money template "...piece%s,\r\n weighing...") never matches its key.
+// Applied identically to keys at load and to lookups, so an already-matching pair still
+// matches (both collapse the same way).
+static Common::String sciChtNormKey(const Common::String &in) {
+	Common::String out;
+	bool pendingSpace = false, started = false;
+	for (uint i = 0; i < in.size(); ++i) {
+		const char c = in[i];
+		if (c == ' ' || c == '\r' || c == '\n' || c == '\t') {
+			pendingSpace = started; // ignore leading whitespace
+		} else {
+			if (pendingSpace)
+				out += ' ';
+			out += c;
+			pendingSpace = false;
+			started = true;
+		}
+	}
+	return out;
+}
+
+// CHT: split a string into sentences. A sentence ends at a run of '.'/'!'/'?' that is
+// followed by whitespace or end-of-string; the trailing whitespace is dropped. Chinese
+// full-width '。'/'！'/'？' (Big5 A1 43 / A1 49 / A1 48) end a sentence too -- their lead
+// byte is A1, so we test the two-byte pair rather than a single char.
+static void sciChtSplitSentences(const Common::String &s, Common::Array<Common::String> &out) {
+	uint start = 0;
+	for (uint i = 0; i < s.size(); ) {
+		const byte c = (byte)s[i];
+		bool isEnd = false;
+		uint next = i + 1;
+		if (c == '.' || c == '!' || c == '?') {
+			while (next < s.size() && (s[next] == '.' || s[next] == '!' || s[next] == '?' ||
+			                           s[next] == '"' || s[next] == '\''))
+				++next;
+			isEnd = (next >= s.size() || s[next] == ' ' || s[next] == '\r' || s[next] == '\n');
+		} else if (c == 0xA1 && i + 1 < s.size()) {
+			const byte c2 = (byte)s[i + 1];
+			if (c2 == 0x43 || c2 == 0x48 || c2 == 0x49) { // 。 ？ ！
+				next = i + 2;
+				while (next + 1 < s.size() && (byte)s[next] == 0xA1 &&
+				       ((byte)s[next + 1] == 0x43 || (byte)s[next + 1] == 0x48 || (byte)s[next + 1] == 0x49))
+					next += 2;
+				isEnd = true;
+			} else {
+				next = i + 2; // some other Big5 symbol -- skip both bytes
+			}
+		} else if (c >= 0x81 && c <= 0xFE && i + 1 < s.size()) {
+			next = i + 2; // Big5 double byte: never mistake its trail byte for punctuation
+		}
+		if (isEnd) {
+			out.push_back(Common::String(s.c_str() + start, next - start));
+			while (next < s.size() && (s[next] == ' ' || s[next] == '\r' || s[next] == '\n'))
+				++next;
+			start = next;
+		}
+		i = next;
+	}
+	if (start < s.size())
+		out.push_back(Common::String(s.c_str() + start, s.size() - start));
+}
+
+// CHT: the game's Narrator/Talker scripts break a long message into several windows,
+// cutting at sentence boundaries, and draw each piece separately. A whole-string lookup
+// therefore misses on every piece. Fall back to sentence alignment: find a table entry
+// whose English text contains `query` as a whole run of consecutive sentences, and return
+// the matching run of Chinese sentences. Only entries whose English and Chinese sentence
+// counts agree are usable -- otherwise the runs don't correspond and we'd return the wrong
+// text, so we decline and let the English through.
+const char *SciEngine::chtChunkFallback(const Common::String &query) const {
+	if (query.size() < 12)
+		return nullptr;
+	Common::HashMap<Common::String, Common::String>::const_iterator cached = _chtChunkCache.find(query);
+	if (cached != _chtChunkCache.end())
+		return cached->_value.empty() ? nullptr : cached->_value.c_str();
+
+	Common::String result;
+	for (Common::HashMap<Common::String, Common::String>::const_iterator it = _chtTranslation.begin();
+	     it != _chtTranslation.end(); ++it) {
+		const Common::String &en = it->_key;
+		if (en.size() <= query.size())
+			continue;
+		const char *at = strstr(en.c_str(), query.c_str());
+		if (!at)
+			continue;
+		const uint pos = (uint)(at - en.c_str());
+		// must start a sentence and end one
+		if (pos != 0 && en[pos - 1] != ' ')
+			continue;
+
+		Common::Array<Common::String> enParts, zhParts;
+		sciChtSplitSentences(en, enParts);
+		sciChtSplitSentences(it->_value, zhParts);
+		if (enParts.size() != zhParts.size() || enParts.size() < 2)
+			continue;
+
+		// locate the run of English sentences that reconstructs `query`
+		uint first = 0, consumed = 0;
+		bool found = false;
+		for (uint i = 0; i < enParts.size(); ++i) {
+			if (consumed == pos) { first = i; found = true; break; }
+			consumed += enParts[i].size() + 1; // + the separating space
+		}
+		if (!found)
+			continue;
+		Common::String joinedEn, joinedZh;
+		for (uint i = first; i < enParts.size(); ++i) {
+			if (i > first) { joinedEn += ' '; joinedZh += ' '; }
+			joinedEn += enParts[i];
+			joinedZh += zhParts[i];
+			if (joinedEn == query) { result = joinedZh; break; }
+			if (joinedEn.size() > query.size())
+				break;
+		}
+		if (!result.empty())
+			break;
+	}
+	_chtChunkCache[query] = result;   // negative results cached too -- one scan per string
+	return result.empty() ? nullptr : _chtChunkCache[query].c_str();
+}
+
+const char *SciEngine::getChtTranslation(const char *original) const {
+	if (_chtTranslation.empty() || !_chtLangOn || !original)   // F8 切到英文時 _chtLangOn=false → 回 nullptr 露原文
+		return nullptr;
+	const Common::String key = sciChtNormKey(original);
+	Common::HashMap<Common::String, Common::String>::const_iterator it = _chtTranslation.find(key);
+	if (it == _chtTranslation.end()) {
+		const char *chunk = chtChunkFallback(key);
+		if (chunk) {
+			if (getenv("SCI_CHT_DEBUG"))
+				warning("CHT-CHUNK[%d]:%s", (int)strlen(original), original);
+			return chunk;
+		}
+		if (getenv("SCI_CHT_DEBUG"))
+			warning("CHT-MISS[%d]:%s", (int)strlen(original), original);
+		return nullptr;
+	}
+	if (getenv("SCI_CHT_DEBUG"))
+		warning("CHT-HIT[%d]:%s", (int)strlen(original), original);
+	return it->_value.c_str();
+}
+
+static Common::String unescapeCht(const Common::String &in) {
+	Common::String out;
+	for (uint i = 0; i < in.size(); ++i) {
+		if (in[i] == '\\' && i + 1 < in.size()) {
+			char n = in[i + 1];
+			if (n == 'n') { out += '\n'; ++i; continue; }
+			if (n == 't') { out += '\t'; ++i; continue; }
+			if (n == '\\') { out += '\\'; ++i; continue; }
+		}
+		out += in[i];
+	}
+	return out;
+}
+
+void SciEngine::loadChtTranslation() {
+	// Runtime translation file: one entry per line, "<english>\t<big5 bytes>".
+	// TAB (0x09) and LF (0x0A) never occur inside Big5, so they are safe
+	// delimiters. Human-maintained source is UTF-8; the build tool converts it
+	// to this Big5 runtime form. Shipped in the game directory as CHT patch data.
+	Common::File f;
+	if (!f.open("translation.tsv"))
+		return;
+	int count = 0;
+	while (!f.eos()) {
+		Common::String line = f.readLine();
+		if (line.empty())
+			continue;
+		const char *s = line.c_str();
+		const char *tab = strchr(s, '\t');
+		if (!tab || tab == s)
+			continue;
+		Common::String key(s, tab - s);
+		Common::String val(tab + 1);
+		if (val.empty())
+			continue;
+		// Unescape "\\n"->newline and "\\\\"->backslash (SCI0/EGA strings contain
+		// hard line breaks, which cannot sit literally in a line-based TSV).
+		_chtTranslation[sciChtNormKey(unescapeCht(key))] = unescapeCht(val);
+		++count;
+	}
+	debug(1, "CHT: loaded %d translation entries", count);
+}
+
 Common::Language SciEngine::getLanguage() const {
+	// Traditional Chinese fan translation: allow forcing ZH_TWN via the target's
+	// "language" config key (e.g. --language=zh_TW) so the CHT patch can be applied
+	// on top of the original English game without a dedicated detection entry.
+	if (ConfMan.hasKey("language")) {
+		if (Common::parseLanguage(ConfMan.get("language")) == Common::ZH_TWN)
+			return Common::ZH_TWN;
+	}
 	return _gameDescription->language;
 }
 
